<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_background"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- Row 1: Source / Category Tag (Tightly pinned to top-right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginBottom="0dp">
        
        <TextView
            android:id="@+id/item_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFCA28"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Row 2: Prominent Title across FULL width (Pure White Bold) -->
    <TextView
        android:id="@+id/item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="4dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1.5dp" />

    <!-- Row 3: Primary Description (Pure Black Content Text) -->
    <TextView
        android:id="@+id/item_en_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#000000"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp" />

    <!-- Chinese Description (Optional Sub-Description) -->
    <TextView
        android:id="@+id/item_zh_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#374151"
        android:textSize="11sp"
        android:lineSpacingExtra="1.5dp" />

</LinearLayout>
